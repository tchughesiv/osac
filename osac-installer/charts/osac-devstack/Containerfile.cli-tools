# Multi-arch CLI tools image for dev-full hook Jobs
# Supports amd64, arm64, ppc64le, s390x
#
# Build and push:
#   podman build --platform linux/amd64,linux/arm64 -t ghcr.io/osac-project/cli-tools:latest -f Containerfile.cli-tools .
#   podman push ghcr.io/osac-project/cli-tools:latest

FROM debian:bookworm-slim

# Install required tools for dev-full hooks
RUN apt-get update && apt-get install -y \
    bash \
    curl \
    jq \
    python3 \
    ca-certificates \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/*

# Install architecture-matched kubectl and grpcurl.
ARG TARGETARCH
ARG KUBECTL_VERSION=v1.32.1
RUN curl --fail --silent --show-error --location \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
      --output /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && curl --fail --silent --show-error --location \
      "https://github.com/fullstorydev/grpcurl/releases/download/v1.9.1/grpcurl_1.9.1_linux_${TARGETARCH}.tar.gz" \
      | tar --no-same-owner -xz -C /usr/local/bin grpcurl

# Verify installations
RUN kubectl version --client && \
    curl --version && \
    jq --version && \
    python3 --version && \
    grpcurl --version

ENTRYPOINT ["/bin/bash"]
